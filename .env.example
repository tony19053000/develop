# LaunchForge environment template.
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATA_DIR=./data
VITE_API_URL=http://localhost:4000

# Agent runtime configuration.
AGENT_MODEL_PROVIDER=google-adk
AGENT_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Sponsor API credentials, added in their implementation phases.
SERPAPI_API_KEY=
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=
XANO_API_KEY=
XANO_WORKSPACE_ID=
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=

# Approval and authorization secrets.
APPROVAL_TOKEN_SECRET=

# Secure execution configuration.
SECURE_EXECUTOR_MODE=development
TEE_PROVIDER=
