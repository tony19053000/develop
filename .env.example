# LaunchForge environment template.
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATA_DIR=./data
VITE_API_URL=http://localhost:4000

# Agent runtime configuration.
AGENT_MODEL_PROVIDER=langgraph
AGENT_MODEL=deterministic-local

# Sponsor API credentials, added in their implementation phases.
SERPAPI_API_KEY=
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=
NAMECOM_API_BASE_URL=https://api.dev.name.com
XANO_API_KEY=
XANO_WORKSPACE_ID=
XANO_INSTANCE_BASE_URL=
FOXIT_API_KEY=
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
FOXIT_API_BASE_URL=https://api.developer-api.foxit.com
FOXIT_DOCUMENT_GENERATION_PATH=/document-generation/api/v1/documents/generate

# Approval and authorization secrets.
APPROVAL_TOKEN_SECRET=

# Secure execution configuration.
SECURE_EXECUTOR_MODE=development
TEE_PROVIDER=google_confidential_space
TEE_ATTESTATION_TOKEN=
TEE_WORKLOAD_IDENTITY=
TEE_IMAGE_DIGEST=
TEE_IMAGE_REFERENCE=
TEE_ATTESTATION_AUDIENCE=launchforge-secure-executor
TEE_GCP_PROJECT_ID=
TEE_GCP_ZONE=
